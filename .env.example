# Copy to .env to override docker-compose defaults. All values here are optional;
# the app runs fully without setting anything (email is logged, captcha uses test keys).

# --- Database (defaults are fine for local) ---
# POSTGRES_DATABASE=wiringbits_db
# POSTGRES_USERNAME=postgres
# POSTGRES_PASSWORD=postgres

# --- App ---
# Generate one with: openssl rand -hex 32
# PLAY_APPLICATION_SECRET=change-me
# Where the web app is served (baked into the frontend bundle at build time).
# Change host/port here AND in the web "ports" mapping if you don't use :8080.
# API_URL=http://localhost:8080/api

# --- Email via AWS SES (optional) ---
# Unset, the app uses a no-op provider that logs the emails instead of sending them.
# Set the provider to "aws" and fill in the credentials to send real emails.
# EMAIL_PROVIDER=aws
# EMAIL_SENDER_ADDRESS=no-reply@example.com
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
